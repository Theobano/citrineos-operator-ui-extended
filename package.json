{
  "name": "citrineos-operator-ui",
  "version": "1.3.0-alpha1",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean-tsbuildinfo": "find . -name tsconfig.tsbuildinfo -not -path '*/node_modules/*' -exec rm -f {} +",
    "clean-dist": "find . -type d -name .next -not -path '*/node_modules/*' -exec rm -rf {} +",
    "clean-cache": "pnpm store prune",
    "clean": "pnpm run clean-dist && pnpm run clean-tsbuildinfo && pnpm run clean-cache",
    "remove-dependencies": "rm -rf pnpm-lock.yaml node_modules",
    "fresh": "pnpm run clean && pnpm run remove-dependencies",
    "fi": "pnpm run fresh && pnpm install",
    "dev": "cross-env NODE_OPTIONS=--max_old_space_size=4096 next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "prettier": "prettier --write .",
    "lint": "eslint ./",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:create-admin": "node --env-file-if-exists=.env.local scripts/create-admin.mjs",
    "lint-fix": "pnpm run prettier && eslint --fix ./",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
