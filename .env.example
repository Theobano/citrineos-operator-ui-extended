# Copy to .env.local and adjust. Variables prefixed NEXT_PUBLIC_ are inlined at BUILD time.

# --- CitrineOS backend ---
HASURA_ADMIN_SECRET=CitrineOS!
NEXT_PUBLIC_API_URL=http://localhost:8090/v1/graphql
NEXT_PUBLIC_WS_URL=ws://localhost:8090/v1/graphql
NEXT_PUBLIC_CITRINE_CORE_URL=http://localhost:8080
NEXT_PUBLIC_FILE_SERVER_URL=http://localhost:8050
NEXT_PUBLIC_TENANT_ID=1

# --- Authentication (better-auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Public URL of this app; also used as the WebAuthn origin / rpID for passkeys.
BETTER_AUTH_URL=http://localhost:3000
# PostgreSQL database holding users, sessions, organizations and passkeys.
AUTH_DATABASE_URL=postgresql://citrine:citrine@localhost:5432/citrine_auth
# Optional: set to "keycloak" to sign in through Keycloak (see KEYCLOAK_* in README).
# NEXT_PUBLIC_AUTH_PROVIDER=keycloak

# --- Branding (just change these to rebrand) ---
# NEXT_PUBLIC_APP_NAME=CitrineOS
# NEXT_PUBLIC_LOGO_URL=/logo-black.svg
# NEXT_PUBLIC_LOGO_DARK_URL=/logo-white.svg
# NEXT_PUBLIC_LOGO_ICON_URL=/logo-collapsed.svg
# NEXT_PUBLIC_FAVICON_URL=/Citrine_Favicon_256_clear3.png
NEXT_PUBLIC_BANNER_MESSAGE=OCPP 2.1 Now Available!

# --- Maps (OpenStreetMap, no API key needed) ---
# NEXT_PUBLIC_DEFAULT_MAP_CENTER_LATITUDE=3.36146906360484
# NEXT_PUBLIC_DEFAULT_MAP_CENTER_LONGITUDE=6.531070378472364
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Optional separate dark tiles; by default the OSM tiles are darkened with a CSS filter.
# NEXT_PUBLIC_MAP_TILE_URL_DARK=
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
# Address search (Nominatim). Self-host for heavy use; the public instance allows 1 request/second.
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# NOMINATIM_CONTACT_EMAIL=you@example.com


# --- Email (nodemailer). Without SMTP_HOST, emails are only logged to the server console. ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=CitrineOS <no-reply@example.com>

ALLOW_IMAGE_UPLOAD=false
